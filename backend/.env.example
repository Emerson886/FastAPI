# =============================================================================
#  环境变量模板 —— 【配置修改总入口】
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env ：  copy .env.example .env      (Windows)
#   2. 按下面 ★ 标注的位置填入你自己的信息
#   3. 保存后重启后端服务即生效
#
# 注意：.env 含敏感信息，已加入 .gitignore，切勿提交到 Git 仓库！
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 应用基础
# -----------------------------------------------------------------------------
PROJECT_NAME=企业知识库问答助手
VERSION=1.0.0
ENVIRONMENT=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000


# -----------------------------------------------------------------------------
# 2. ★★★ MySQL 数据库（必改）★★★
# -----------------------------------------------------------------------------
# 建库语句（先在你的 MySQL 里执行一次）：
#   CREATE DATABASE kb_assistant DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root                 # ★★★ 改成你的 MySQL 密码 ★★★
MYSQL_DB=kb_assistant               # ★★★ 改成你的库名（需先建库）★★★
MYSQL_CHARSET=utf8mb4

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false                       # 想在控制台看 SQL 就改成 true
DB_AUTO_CREATE=true                 # 启动时自动建表；生产环境建议 false + Alembic 迁移


# -----------------------------------------------------------------------------
# 3. ★★★ 大模型（必改）★★★
# -----------------------------------------------------------------------------
# 采用 OpenAI 兼容协议，换服务商只改这三个值即可：
#   DeepSeek  : https://api.deepseek.com/v1            模型 deepseek-chat
#   通义千问  : https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   Kimi      : https://api.moonshot.cn/v1             模型 moonshot-v1-8k
#   智谱 GLM  : https://open.bigmodel.cn/api/paas/v4   模型 glm-4-plus
#   本地 vLLM : http://127.0.0.1:8001/v1              模型 你部署的模型名
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-请替换成你自己的APIKey        # ★★★ 改成你的大模型 API Key ★★★
LLM_MODEL=deepseek-chat                      # ★★★ 改成你要用的模型 ★★★
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_STREAMING=true


# -----------------------------------------------------------------------------
# 4. ★★★ Embedding 向量化模型（必改）★★★
# -----------------------------------------------------------------------------
# 注意：DeepSeek 官方目前不提供 embedding 接口，推荐以下任一方案：
#   SiliconFlow : https://api.siliconflow.cn/v1     模型 BAAI/bge-m3        维度 1024
#   通义千问    : https://dashscope.aliyuncs.com/compatible-mode/v1  模型 text-embedding-v3  维度 1024
#   OpenAI      : https://api.openai.com/v1         模型 text-embedding-3-small  维度 1536
# 也可以用和对话相同的地址（若该服务支持 embeddings）。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-请替换成你自己的EmbeddingKey   # ★★★ 改成 Embedding 服务的 Key ★★★
EMBEDDING_MODEL=BAAI/bge-m3                        # ★★★ 改成 Embedding 模型名 ★★★
EMBEDDING_DIMENSION=1024                           # ★★★ 改成与模型匹配的向量维度 ★★★


# -----------------------------------------------------------------------------
# 5. RAG 检索参数
# -----------------------------------------------------------------------------
# 存储目录留空即用默认值 backend/storage/chroma。
# ⚠ 重要：不要写成  KEY=  # 说明文字  的形式！
#   dotenv 解析器【不会去掉行尾注释】，会把注释内容当成路径值，
#   导致日志/向量数据被写到名字很怪的目录里（日志会跑到 backend/app/backend/logs）。
#   需要自定义时，把路径直接写在等号后、且不要跟注释。
# CHROMA_PERSIST_DIR=backend/storage/chroma
RAG_COLLECTION=enterprise_kb
RAG_TOP_K=4                         # 每次检索召回的知识片段数
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100


# -----------------------------------------------------------------------------
# 6. ★★★ JWT 安全配置（生产必改）★★★
# -----------------------------------------------------------------------------
# 生成随机密钥的命令： python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string   # ★★★ 生产必改 ★★★
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 访问令牌 1 天
REFRESH_TOKEN_EXPIRE_MINUTES=10080      # 刷新令牌 7 天


# -----------------------------------------------------------------------------
# 7. 跨域（前端地址，多个用英文逗号分隔）
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# 8. 文件上传
# -----------------------------------------------------------------------------
# 留空即用默认值 backend/storage/uploads（同样不要跟注释）
# UPLOAD_DIR=backend/storage/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.docx,.csv


# -----------------------------------------------------------------------------
# 9. 日志
# -----------------------------------------------------------------------------
# 留空即用默认值 backend/logs（同样不要跟注释）
# LOG_DIR=backend/logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
SQL_LOG_SLOW_MS=500


# -----------------------------------------------------------------------------
# 10. 内置管理员账号（首次启动自动创建）
# -----------------------------------------------------------------------------
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123456     # ★★★ 登录后请立即修改 ★★★
FIRST_ADMIN_EMAIL=admin@example.com
